{
  "lastChangelogVersion": "0.87.1",
  "theme": "light/dark",
  "defaultProvider": "opencode-go",
  "defaultModel": "space-bunny-free",
  "terminal": {
    "showTerminalProgress": true
  },
  "followUpMode": "one-at-a-time",
  "transport": "auto",
  "showCacheMissNotices": true,
  "enableInstallTelemetry": false,
  "tuiMode": "regular",
  "fullscreenCopyOnSelect": false,
  "fullscreenScrollbar": "always",
  "editorPaddingX": 2,
  "outputPad": 1,
  "packages": [
    "npm:pi-ask-user",
    "npm:@0xkahi/pi-vim-keys",
    "npm:pi-ollama",
    "npm:pi-caveman",
    "npm/node_modules/@0xkobold/pi-web",
    "npm:pi-mcp-extension",
    "npm:pi-web-search",
    "npm:pi-subagents",
    "npm:@patimweb/pi-mindplace"
  ],
  "extensions": [
    "~/.pi/agent/extensions/vim-keys-patches.ts",
    "~/.pi/agent/extensions/backlog-guard.ts"
  ],
  "showHardwareCursor": true,
  "hideThinkingBlock": true,
  "defaultTools": [
    "read",
    "write",
    "edit",
    "bash"
  ],
  "enabledModels": []
}