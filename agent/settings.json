{
  "lastChangelogVersion": "0.87.1",
  "theme": "light/dark",
  "defaultProvider": "opencode-go",
  "defaultModel": "space-bunny-free",
  "terminal": {
    "showTerminalProgress": true
  },
  "followUpMode": "one-at-a-time",
  "transport": "auto",
  "showCacheMissNotices": true,
  "enableInstallTelemetry": false,
  "tuiMode": "regular",
  "fullscreenCopyOnSelect": false,
  "fullscreenScrollbar": "always",
  "editorPaddingX": 2,
  "outputPad": 1,
  "packages": [
    "npm:pi-ask-user",
    "npm:@0xkahi/pi-vim-keys",
    "npm:pi-ollama",
    "npm:pi-caveman",
    "npm:pi-mcp-extension",
    "npm:pi-web-search",
    "npm:pi-subagents",
    "npm:@patimweb/pi-mindplace"
  ],
  "extensions": [],
  "showHardwareCursor": true,
  "hideThinkingBlock": true,
  "defaultTools": [
    "read",
    "write",
    "edit",
    "bash"
  ],
  "subagents": {
    "agentOverrides": {
      "reviewer": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "watchdog_diff",
          "contact_supervisor"
        ]
      },
      "researcher": {
        "tools": [
          "read",
          "write",
          "grep",
          "find",
          "ls",
          "bash",
          "web_search",
          "url_context"
        ]
      },
      "evidence-auditor": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "web_search",
          "url_context"
        ]
      }
    }
  },
  "enabledModels": []
}