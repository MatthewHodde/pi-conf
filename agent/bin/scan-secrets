#!/usr/bin/env bash
# Contract: exit 0 = clean, exit 1 = findings printed as "path:line rule-id",
# exit >1 = scanner error. No secret value ever reaches stdout.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
config="$script_dir/scan-secrets.toml"
target="${1:-.}"

die() {
  printf 'scan-secrets: %s\n' "$1" >&2
  exit "$2"
}

gitleaks="${GITLEAKS_BIN:-$script_dir/gitleaks}"
[ -x "$gitleaks" ] || die "gitleaks missing at $gitleaks; set GITLEAKS_BIN" 127

[ -f "$config" ] || die "config not found: $config" 2
command -v jq >/dev/null 2>&1 || die "jq not found in PATH" 127

report="$(mktemp)" || die "mktemp failed" 2
porcelain="$(mktemp)" || { rm -f "$report"; die "mktemp failed" 2; }
trap 'rm -f "$report" "$porcelain"' EXIT

# Inside a git work tree the scan set must match `git add -A`: staged,
# unstaged, and untracked non-ignored files. Scan the repo root so report
# paths share one root, then filter findings to the status entries.
git_root=""
scan_target="$target"
if git_root="$(git -C "$target" rev-parse --show-toplevel 2>/dev/null)" && [ -n "$git_root" ]; then
  scan_target="$git_root"
else
  git_root=""
fi

"$gitleaks" dir "$scan_target" --redact --report-format json --report-path "$report" -c "$config"
status=$?

if [ "$status" -eq 0 ]; then
  [ -f "$report" ] || die "gitleaks wrote no report (scanner error)" 2
  exit 0
fi

if [ "$status" -eq 1 ]; then
  # gitleaks exits 1 both for findings and for fatal errors, so the report
  # file is what tells the two apart.
  if [ -f "$report" ] && jq -e 'type == "array"' "$report" >/dev/null 2>&1; then
    if [ "$(jq 'length' "$report")" -gt 0 ]; then
      if [ -z "$git_root" ]; then
        jq -r '.[] | "\(.File):\(.StartLine) \(.RuleID)"' "$report" | sort -u
        exit 1
      fi
      git -C "$git_root" status --porcelain -z --untracked-files=all >"$porcelain" ||
        die "git status failed for $git_root" 2
      # NUL-separated records: "XY path". Rename/copy records carry a
      # second NUL-terminated path. Deleted entries hold no content.
      landmines=()
      pending=0
      rec=""
      while IFS= read -r -d '' rec || [ -n "$rec" ]; do
        if [ "$pending" -eq 1 ]; then
          landmines+=("$rec")
          pending=0
          rec=""
          continue
        fi
        if [ "${#rec}" -lt 3 ]; then
          rec=""
          continue
        fi
        case "${rec:0:2}" in
          *R* | *C*)
            landmines+=("${rec:3}")
            pending=1
            ;;
          *D*) rec=""; continue ;;
          *) landmines+=("${rec:3}") ;;
        esac
        rec=""
      done <"$porcelain"
      landmine_json="$(jq -n --args '($ARGS.positional | unique)' -- "${landmines[@]}")" ||
        die "cannot build git status list" 2
      filtered="$(jq -r --argjson land "$landmine_json" --arg rootp "$git_root/" '
        def norm:
          if startswith($rootp) then .[($rootp | length):]
          elif startswith("./") then .[2:]
          else . end;
        [ .[]
          | (.File | norm) as $f
          | select(($land | index($f)) != null)
          | "\($f):\(.StartLine) \(.RuleID)" ]
        | unique[]
      ' "$report")" || die "finding filter failed" 2
      if [ -n "$filtered" ]; then
        printf '%s\n' "$filtered"
        exit 1
      fi
      exit 0
    fi
    die "gitleaks exited 1 with no findings (config or usage error)" 2
  fi
  die "gitleaks failed before writing a report (config or usage error)" 2
fi

case "$status" in
  126) die "cannot execute gitleaks: $gitleaks" 126 ;;
  127) die "gitleaks not found: $gitleaks" 127 ;;
  *) die "gitleaks error (exit $status)" "$status" ;;
esac
