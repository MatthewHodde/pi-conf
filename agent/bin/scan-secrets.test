#!/usr/bin/env bash
# Probes the scanner contract: exit 0 clean, exit 1 findings, output lines
# match "path:line rule-id", and no fixture secret value reaches the output.
set -uo pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
scanner="$here/scan-secrets"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

fails=0
pass() { printf 'PASS %s\n' "$1"; }
fail() {
  printf 'FAIL %s\n' "$1"
  fails=$((fails + 1))
}

rand() {
  LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c "$1" || :
}

# run <dir> sets rc, stdout, stderr from one scanner call.
run() {
  "$scanner" "$1" >"$work/out" 2>"$work/err"
  rc=$?
  stdout="$(cat "$work/out")"
  stderr="$(cat "$work/err")"
}

check_format() {
  if printf '%s\n' "$2" | grep -Ev '^.*:[0-9]+ [a-z0-9-]+$' | grep -q .; then
    fail "$1: output line outside '^path:line rule-id$' format"
    return 1
  fi
}

check_no_leak() {
  local name="$1" blob="$2" secret
  shift 2
  for secret in "$@"; do
    case "$blob" in
      *"$secret"*)
        fail "$name: secret value appears in scanner output"
        return 1
        ;;
    esac
  done
}

expect_clean() {
  local name="$1" dir="$2"
  run "$dir"
  if [ "$rc" -ne 0 ]; then
    fail "$name: exit $rc, want 0"
    return
  fi
  if [ -n "$stdout" ]; then
    fail "$name: findings output not empty: $stdout"
    return
  fi
  pass "$name"
}

# expect_red <name> <dir> <required rule-id or -> <secret>...
expect_red() {
  local name="$1" dir="$2" rule="$3"
  shift 3
  run "$dir"
  if [ "$rc" -ne 1 ]; then
    fail "$name: exit $rc, want 1"
    return
  fi
  if [ -z "$stdout" ]; then
    fail "$name: findings output empty"
    return
  fi
  check_format "$name" "$stdout" || return
  if [ "$rule" != "-" ] && ! printf '%s\n' "$stdout" | grep -q " $rule\$"; then
    fail "$name: no '$rule' finding in: $stdout"
    return
  fi
  check_no_leak "$name" "$stdout
$stderr" "$@" || return
  pass "$name"
}

clean="$work/clean"
mkdir -p "$clean/src"
cat > "$clean/README.md" <<'EOF'
# Sample project

Users change the default password after first login.
EOF
cat > "$clean/src/app.js" <<'EOF'
export function run(options) {
  return fetch(url, { headers: options.headers });
}
EOF
cat > "$clean/.env" <<'EOF'
API_KEY=${API_KEY}
PASSWORD=changeme
PASSWORD=example123
SECRET=<redacted>
TOKEN=xxxxxxxx
DEBUG=true
EOF
expect_clean "clean fixture is green" "$clean"

pat="$work/pat"
mkdir -p "$pat"
pat_secret="ghp_$(rand 36)"
printf '%s\n' "$pat_secret" >"$pat/token.txt"
expect_red "GitHub PAT flags" "$pat" "-" "$pat_secret"

pem="$work/pem"
mkdir -p "$pem"
pem_body="$(rand 64)"
{
  echo "-----BEGIN RSA PRIVATE KEY-----"
  echo "$pem_body"
  echo "-----END RSA PRIVATE KEY-----"
} >"$pem/key.pem"
expect_red "PEM private key flags" "$pem" "-" "$pem_body"

env_key="$work/env-key"
mkdir -p "$env_key"
key_secret="$(rand 32)"
printf 'API_KEY=%s\n' "$key_secret" >"$env_key/.env"
expect_red "env API_KEY flags" "$env_key" "-" "$key_secret"

env_pw="$work/env-pw"
mkdir -p "$env_pw"
password_value="hunter2SuperSecretValue123"
printf 'PASSWORD=%s\n' "$password_value" >"$env_pw/.env"
expect_red "env PASSWORD flags env-credential" "$env_pw" "env-credential" "$password_value"

bearer="$work/bearer"
mkdir -p "$bearer"
bearer_secret="$(rand 40)"
printf 'Authorization: Bearer %s\n' "$bearer_secret" >"$bearer/headers.txt"
expect_red "bearer header flags bearer-token" "$bearer" "bearer-token" "$bearer_secret"

git_init() {
  git -C "$1" init -q
}

git_commit() {
  git -C "$1" add -A &&
    git -C "$1" -c user.email=x@y -c user.name=x -c commit.gpgsign=false commit -q -m "$2"
}

g_ignored="$work/git-ignored"
mkdir -p "$g_ignored/.ignored"
git_init "$g_ignored"
printf '.ignored/\n' >"$g_ignored/.gitignore"
printf '# Fixture\n' >"$g_ignored/README.md"
git_commit "$g_ignored" "base"
g_ignored_secret="ghp_$(rand 36)"
printf '%s\n' "$g_ignored_secret" >"$g_ignored/.ignored/secret.txt"
expect_clean "git: secret only in gitignored file is out of scan set" "$g_ignored"

# An ignore rule never covers a tracked file, so a change to one must still
# reach the scanner even though its directory is ignored.
g_ig_track="$work/git-ignored-tracked"
mkdir -p "$g_ig_track/.ignored"
git_init "$g_ig_track"
printf '.ignored/\n' >"$g_ig_track/.gitignore"
printf 'safe line\n' >"$g_ig_track/.ignored/kept.txt"
git -C "$g_ig_track" add -f .ignored/kept.txt
git_commit "$g_ig_track" "base with tracked file in ignored dir"
g_ig_track_secret="ghp_$(rand 36)"
printf '%s\n' "$g_ig_track_secret" >>"$g_ig_track/.ignored/kept.txt"
git -C "$g_ig_track" add -f .ignored/kept.txt
expect_red "git: staged change to tracked file in ignored dir flags" "$g_ig_track" "github-pat" "$g_ig_track_secret"

g_untracked="$work/git-untracked"
mkdir -p "$g_untracked/sub"
git_init "$g_untracked"
printf '# Fixture\n' >"$g_untracked/README.md"
git_commit "$g_untracked" "base"
g_untracked_secret="ghp_$(rand 36)"
printf '%s\n' "$g_untracked_secret" >"$g_untracked/sub/new.txt"
expect_clean "git: untracked unstaged secret is out of the payload" "$g_untracked"

g_committed="$work/git-committed"
mkdir -p "$g_committed"
git_init "$g_committed"
g_committed_secret="ghp_$(rand 36)"
printf '%s\n' "$g_committed_secret" >"$g_committed/tracked-secret.txt"
git_commit "$g_committed" "add secret"
expect_clean "git: secret committed with clean tree is out of scan set" "$g_committed"

g_append="$work/git-append"
mkdir -p "$g_append"
git_init "$g_append"
printf 'safe line\n' >"$g_append/notes.txt"
git_commit "$g_append" "base"
g_append_secret="ghp_$(rand 36)"
printf '%s\n' "$g_append_secret" >>"$g_append/notes.txt"
expect_clean "git: unstaged tracked edit is outside the staged payload" "$g_append"

g_staged="$work/git-staged"
mkdir -p "$g_staged"
git_init "$g_staged"
printf '# Fixture\n' >"$g_staged/README.md"
git_commit "$g_staged" "base"
g_staged_secret="ghp_$(rand 36)"
printf '%s\n' "$g_staged_secret" >"$g_staged/staged.txt"
git -C "$g_staged" add staged.txt
expect_red "git: secret staged via git add flags" "$g_staged" "github-pat" "$g_staged_secret"

g_renamed="$work/git-renamed"
mkdir -p "$g_renamed"
git_init "$g_renamed"
g_renamed_secret="ghp_$(rand 36)"
printf '%s\n' "$g_renamed_secret" >"$g_renamed/old-name.txt"
git_commit "$g_renamed" "add secret"
git -C "$g_renamed" mv old-name.txt new-name.txt
# A pure rename diffs to a path change with no added lines, so the staged
# scan finds nothing new entering the repo: the content landed in an
# earlier commit, which the gate judges on its own terms.
expect_clean "git: pure rename adds no new content to the payload" "$g_renamed"

g_deleted="$work/git-deleted"
mkdir -p "$g_deleted"
git_init "$g_deleted"
g_deleted_secret="ghp_$(rand 36)"
printf '%s\n' "$g_deleted_secret" >"$g_deleted/doomed.txt"
git_commit "$g_deleted" "add secret"
git -C "$g_deleted" rm -q doomed.txt
expect_clean "git: deleted file is out of the payload" "$g_deleted"

# The payload list reaches gitleaks as argv, so a large payload is chunked:
# past the exec cap the scanner used to die with exit 2 before reporting.
g_big="$work/git-big"
mkdir -p "$g_big/big"
git_init "$g_big"
printf '# Fixture\n' >"$g_big/README.md"
git_commit "$g_big" "base"
big_i=1
while [ "$big_i" -le 15000 ]; do
  printf x >"$g_big/big/file-$(printf '%04d' "$big_i")-aaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  big_i=$((big_i + 1))
done
g_big_secret="ghp_$(rand 36)"
printf '%s\n' "$g_big_secret" >"$g_big/planted.txt"
expect_clean "git: large untracked tree stays out of the payload" "$g_big"

g_payload="$work/git-payload"
mkdir -p "$g_payload/many"
git_init "$g_payload"
printf '# Fixture\n' >"$g_payload/README.md"
git_commit "$g_payload" "base"
payload_i=1
while [ "$payload_i" -le 1200 ]; do
  printf x >"$g_payload/many/file-$(printf '%04d' "$payload_i")"
  payload_i=$((payload_i + 1))
done
g_payload_secret="ghp_$(rand 36)"
printf '%s\n' "$g_payload_secret" >"$g_payload/staged-secret.txt"
git -C "$g_payload" add many staged-secret.txt
expect_red "git: large staged payload still exits 1 with findings" "$g_payload" "github-pat" "$g_payload_secret"

if [ "$fails" -gt 0 ]; then
  printf '%s case(s) failed\n' "$fails"
  exit 1
fi
echo "all cases pass"
